DATABASE_URL=postgresql://username:password@localhost:5432/team_bahrain
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Required in production (NODE_ENV=production, e.g. behind Nginx on EC2) —
# without it, NextAuth rejects every request with "UntrustedHost" and login
# breaks entirely. Not needed in local dev (trustHost defaults on there).
AUTH_TRUST_HOST=true

# S3 upload storage — see README.md "Uploads (S3)" for the bucket policy,
# CORS config, and IAM policy this expects.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
